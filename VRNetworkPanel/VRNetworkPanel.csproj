<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VRNetworkPanel</AssemblyName>
    <RootNamespace>VRNetworkPanel</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Path to your V Rising install. Override with: dotnet build -p:VRisingDir="D:\Games\VRising" -->
    <VRisingDir Condition="'$(VRisingDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VRising</VRisingDir>
    <BepInExDir>$(VRisingDir)\BepInEx</BepInExDir>
    <CopyToPlugins Condition="'$(CopyToPlugins)' == ''">true</CopyToPlugins>
  </PropertyGroup>

  <!-- Bloodpebble's opt-in marker for a hot-reloadable plugin. Plugin.Unload frees everything
       this mod made (it writes nothing to the game), so the claim is true. -->
  <ItemGroup>
    <AssemblyMetadata Include="Reloadable" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- Interop assemblies generated by BepInEx on the first game launch. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <!-- GUI / GUIStyle / Event for the readout. TextAnchor and FontStyle are GUIStyle
         properties but live in TextRenderingModule, so IMGUI alone does not compile. -->
    <Reference Include="$(BepInExDir)\interop\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Entities.dll" Private="false" />
    <!-- ProjectM.ClientBootstrapSystem, the root of the path to the connection. -->
    <Reference Include="$(BepInExDir)\interop\ProjectM.dll" Private="false" />
    <!-- ClientNetworkLayer / IClientTransportLayer / ClientConnectState are Stunlock.Network;
         ClientSteamTransportLayer, SteamNetworkingClient and QuickConnectionStatus (ping +
         delivery quality = loss in/out) are Stunlock.Network.Steam;
         QuickConnectionStatus.ConnectionState is an enum from the Steamworks.NET assembly. -->
    <Reference Include="$(BepInExDir)\interop\Stunlock.Network.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Stunlock.Network.Steam.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the DLL straight into BepInEx/plugins after a successful build -->
  <Target Name="CopyToBepInEx" AfterTargets="Build" Condition="'$(CopyToPlugins)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" ContinueOnError="true" />
  </Target>

</Project>
